# Authenticate mail OAuth tokens against Keycloak's audience-restricted
# introspection endpoint through the private Caddy route.
introspection_mode = post
introspection_url = https://p0-mail:${P0_MAIL_OAUTH_SECRET}@keycloak.datamancy.net/realms/webservices/protocol/openid-connect/token/introspect
username_attribute = email
active_attribute = active
active_value = true
tls_ca_cert_file = /etc/dovecot/caddy-root.crt
